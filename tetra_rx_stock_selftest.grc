options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Same decoder as tetra_rx_stock, fed from tetra_test_72k.cf32 (tetra_testgen.py)
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: tetra_rx_stock_selftest
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: TETRA RX stock FEC - SELF-TEST (synthetic file, no RTL-SDR)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: add_blk1
  id: blocks_add_xx
  parameters:
    alias: ''
    comment: ''
    type: float
    num_inputs: '2'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 864
    - 924
    rotation: 0
    state: enabled
- name: add_blk2
  id: blocks_add_xx
  parameters:
    alias: ''
    comment: ''
    type: float
    num_inputs: '3'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 864
    - 760
    rotation: 0
    state: enabled
- name: add_bsch
  id: blocks_add_xx
  parameters:
    alias: ''
    comment: data + 0 = data; tags from both inputs survive
    type: float
    num_inputs: '2'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 864
    - 636
    rotation: 0
    state: enabled
- name: algorithm
  id: variable_adaptive_algorithm
  parameters:
    comment: ''
    cons: constellation
    delta: '10.0'
    ffactor: '0.99'
    modulus: '1'
    step_size: '.005'
    type: cma
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2264
    - 12
    rotation: 0
    state: true
- name: analog_agc_xx_0
  id: analog_agc_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gain: '1.0'
    max_gain: '65536'
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: 10e-3
    reference: '0.25'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 528
    - 300.0
    rotation: 0
    state: enabled
- name: bsch_deint
  id: trellis_permutation
  parameters:
    alias: ''
    comment: 'SOFT DE-INTERLEAVE: out[i] = in[(a*(i+1)) mod K]'
    type: float
    interleaver_size: '120'
    table: tetra_fec.DEINT_120
    syms_per_block: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 1040
    rotation: 0
    state: enabled
- name: bsch_descr
  id: blocks_multiply_const_vxx
  parameters:
    alias: ''
    comment: |-
      SOFT DESCRAMBLE: x (+-1) per bit.
      Changing k takes effect between whole vectors
    type: float
    const: tetra_fec.BSCH_SCR
    vlen: '120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 392
    - 1048
    rotation: 0
    state: enabled
- name: bsch_dp3
  id: blocks_deinterleave
  parameters:
    alias: ''
    comment: 'DE-PUNCTURE (1/2): split every 3 received bits'
    type: float
    num_streams: '3'
    blocksize: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 992
    - 1048
    rotation: 0
    state: enabled
- name: bsch_dp8
  id: blocks_interleave
  parameters:
    alias: ''
    comment: |-
      DE-PUNCTURE (2/2): rebuild 8 mother bits,
      0.0 (erasure) where the TX punctured
    type: float
    num_streams: '8'
    blocksize: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1160
    - 1040
    rotation: 0
    state: enabled
- name: bsch_erase
  id: blocks_null_source
  parameters:
    alias: ''
    comment: |-
      Erasures for de-puncturing (0.0 = no information).
      One per chain: a shared source would couple the two chains' buffers
    type: float
    vlen: '1'
    num_outputs: '1'
    bus_structure_source: '[[0,],]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 1136
    rotation: 0
    state: enabled
- name: bsch_p2s
  id: pdu_pdu_to_tagged_stream
  parameters:
    alias: ''
    comment: BSCH cuts -> stream (whole blocks only, so everything below stays aligned)
    type: float
    tag: packet_len
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 1040
    rotation: 0
    state: enabled
- name: bsch_s2t
  id: blocks_stream_to_tagged_stream
  parameters:
    alias: ''
    comment: ''
    type: byte
    vlen: '1'
    packet_len: tetra_fec.BSCH_STEPS
    len_tag_key: '"blk"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1592
    - 1048
    rotation: 0
    state: enabled
- name: bsch_s2v
  id: blocks_stream_to_vector
  parameters:
    alias: ''
    comment: ''
    type: float
    num_items: '120'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 232
    - 1048
    rotation: 0
    state: enabled
- name: bsch_t2p
  id: pdu_tagged_stream_to_pdu
  parameters:
    alias: ''
    comment: ''
    type: byte
    tag: blk
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1800
    - 1048
    rotation: 0
    state: enabled
- name: bsch_v2s
  id: blocks_vector_to_stream
  parameters:
    alias: ''
    comment: ''
    type: float
    num_items: '120'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 600
    - 1048
    rotation: 0
    state: enabled
- name: bsch_vit
  id: trellis_viterbi_combined_xx
  parameters:
    alias: ''
    comment: 'SOFT VITERBI: K=5 rate-1/4 mother code, terminated (start/end state 0)'
    type: f
    out_type: b
    fsm_args: 2, 16, 16, tetra_fec.NS, tetra_fec.OS
    block_size: tetra_fec.BSCH_STEPS
    init_state: '0'
    final_state: '0'
    dim: '4'
    table: tetra_fec.VIT_TABLE
    metric_type: digital.TRELLIS_EUCLIDEAN
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 1040
    rotation: 0
    state: enabled
- name: cell_key
  id: variable
  parameters:
    alias: ''
    comment: |-
      Extended colour code MCC<<20|MNC<<6|CC. Set at run time by
      Message Pair to Var from the decoded SYNC (0 = not known yet)
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1720
    - 12
    rotation: 0
    state: enabled
- name: cell_to_var
  id: blocks_msgpair_to_var
  parameters:
    alias: ''
    comment: Sets variable cell_key -> hd_scr -> SCH/HD descrambler
    target: cell_key
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2288
    - 1120
    rotation: 0
    state: enabled
- name: ch_rate
  id: variable
  parameters:
    comment: 72 kS/s = 4 samples/symbol
    value: samp_rate/decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 92
    rotation: 0
    state: enabled
- name: chan_cut
  id: variable
  parameters:
    alias: ''
    comment: |-
      Channel filter -6 dB point. TETRA occupies +-12.15 kHz; neighbours start at
      +-12.85 kHz (25 kHz raster). 16 kHz alone let them bias the FLL by kHz
    value: 13.5e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1856
    - 92
    rotation: 0
    state: enabled
- name: chan_lpf
  id: fir_filter_xxx
  parameters:
    alias: ''
    comment: |-
      Tight channel filter at 72 kS/s (~80 taps, cheap): keeps the 25 kHz
      neighbours out of the FLL band-edge filters (measured: a +9 dB neighbour
      otherwise pulls the FLL ~2 kHz off)
    type: ccf
    decim: '1'
    taps: firdes.low_pass(1.0, ch_rate, chan_cut, 3e3)
    samp_delay: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 440
    - 412
    rotation: 0
    state: enabled
- name: clock_0
  id: digital_pfb_clock_sync_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: Matched RRC + symbol timing in one block, 4 sps -> 1 sps
    filter_size: nfilts
    init_phase: nfilts/2
    loop_bw: '0.0628'
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    osps: '1'
    sps: sps
    taps: rrc_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 904
    - 232.0
    rotation: 0
    state: enabled
- name: const_0
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: |-
      Blue: symbols after clock sync + equaliser: a THIN RING = timing locked.
      Red: phase steps after the 4th-power derotator = what the decoder sees.
        4 tight clusters at +-45/+-135 deg = healthy.
      Green: the same steps BEFORE the derotator. Their rotation = carrier left over
        after the FLL (also on the number sink). > ~20 deg rotation: fix ppm.
    grid: 'True'
    gui_hint: 1,2,1,1
    label1: symbols
    label10: ''
    label2: phase steps -> decoder
    label3: raw phase steps
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '0'
    marker10: '0'
    marker2: '0'
    marker3: '0'
    marker4: '0'
    marker5: '0'
    marker6: '0'
    marker7: '0'
    marker8: '0'
    marker9: '0'
    name: '"blue: symbols (thin ring = OK)   red: steps to decoder (4 clusters on diagonals)   green: before derotator"'
    nconnections: '3'
    size: '1024'
    style1: '0'
    style10: '0'
    style2: '0'
    style3: '0'
    style4: '0'
    style5: '0'
    style6: '0'
    style7: '0'
    style8: '0'
    style9: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    xmax: '2'
    xmin: '-2'
    ymax: '2'
    ymin: '-2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2072
    - 368
    rotation: 0
    state: enabled
- name: constellation
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[1+1j, -1+1j, 1-1j, -1-1j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 2, 3]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2264
    - 112
    rotation: 0
    state: enabled
- name: corr_p
  id: digital_correlate_access_code_tag_xx
  parameters:
    alias: ''
    comment: |-
      Normal burst with two half-slot blocks: 22-bit NTS2, <= 1 error.
      Tag on slot bit 266. ~0.2 false hits/s on random data (2.2/s at <= 2 errors);
      CRC + 2-copy rule reject the rest
    type: float
    access_code: '0111101001000011011110'
    threshold: '1'
    tagname: slot
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 208
    - 860
    rotation: 0
    state: enabled
- name: corr_y
  id: digital_correlate_access_code_tag_xx
  parameters:
    alias: ''
    comment: |-
      Sync burst: 38-bit training seq y, <= 4 errors.
      Tag lands on the bit after y = slot bit 252
    type: float
    access_code: '11000001100111001110100111000001100111'
    threshold: '4'
    tagname: slot
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 208
    - 700
    rotation: 0
    state: enabled
- name: cut_blk1
  id: pdu_tags_to_pdu_x
  parameters:
    alias: ''
    comment: 'Block 1 of normal bursts: 216 soft bits'
    type: f
    start_tag: slot
    end_tag: EOB
    max_pdu_size: '216'
    rate: 2*ch_rate/sps
    prepend: '[]'
    cfg_port: 'False'
    pub_det: 'False'
    tail_size: '0'
    eob_alignment: '1'
    eob_offset: '0'
    start_time: '0.0'
    boost_time: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1032
    - 908
    rotation: 0
    state: enabled
- name: cut_blk2
  id: pdu_tags_to_pdu_x
  parameters:
    alias: ''
    comment: 'Block 2 of sync AND normal bursts: 216 soft bits'
    type: f
    start_tag: slot
    end_tag: EOB
    max_pdu_size: '216'
    rate: 2*ch_rate/sps
    prepend: '[]'
    cfg_port: 'False'
    pub_det: 'False'
    tail_size: '0'
    eob_alignment: '1'
    eob_offset: '0'
    start_time: '0.0'
    boost_time: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1032
    - 748
    rotation: 0
    state: enabled
- name: cut_bsch
  id: pdu_tags_to_pdu_x
  parameters:
    alias: ''
    comment: 'BSCH: 120 soft bits from the tag'
    type: f
    start_tag: slot
    end_tag: EOB
    max_pdu_size: '120'
    rate: 2*ch_rate/sps
    prepend: '[]'
    cfg_port: 'False'
    pub_det: 'False'
    tail_size: '0'
    eob_alignment: '1'
    eob_offset: '0'
    start_time: '0.0'
    boost_time: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1032
    - 620
    rotation: 0
    state: enabled
- name: d_bsch
  id: blocks_delay
  parameters:
    alias: ''
    comment: 'DATA late by 158: y tag now sits on BSCH bit 94'
    type: float
    delay: tetra_fec.D_BSCH
    num_ports: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 656
    - 620
    rotation: 0
    state: enabled
- name: d_nb1
  id: blocks_delay
  parameters:
    alias: ''
    comment: 'DATA late by 252: p tag now sits on block 1 (bit 14)'
    type: float
    delay: tetra_fec.D_NB1
    num_ports: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 656
    - 940
    rotation: 0
    state: enabled
- name: d_nb2
  id: blocks_delay
  parameters:
    alias: ''
    comment: 'TAG late by 16: lands on block 2 (bit 282)'
    type: float
    delay: tetra_fec.D_NB2
    num_ports: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 656
    - 820
    rotation: 0
    state: enabled
- name: d_sb2
  id: blocks_delay
  parameters:
    alias: ''
    comment: 'TAG late by 30: lands on block 2 (bit 282)'
    type: float
    delay: tetra_fec.D_SB2
    num_ports: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 656
    - 740
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: 1.152 MS/s / 16 = 72 kS/s
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 520
    - 12
    rotation: 0
    state: enabled
- name: diff_0
  id: digital_diff_phasor_cc
  parameters:
    affinity: ''
    alias: ''
    comment: 'y[n] = x[n] * conj(x[n-1]): the pi/4-DQPSK phase step'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1336
    - 224.0
    rotation: 0
    state: enabled
- name: digital_linear_equalizer_0
  id: digital_linear_equalizer
  parameters:
    adapt_after_training: 'True'
    affinity: ''
    alg: algorithm
    alias: ''
    comment: CMA, T-spaced, 16 taps. Training fields unused (no corr_est tags in this graph)
    maxoutbuf: '0'
    minoutbuf: '0'
    num_taps: '16'
    sps: '1'
    training_sequence: '[ ]'
    training_start_tag: corr_est
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1120
    - 224.0
    rotation: 0
    state: true
- name: dqpsk_diff
  id: variable
  parameters:
    comment: |-
      Phase CHANGE per symbol -> dibit (EN 300 392-2 Table 5.x):
      +pi/4=00  +3pi/4=01  -pi/4=10  -3pi/4=11  (index = dibit value)
    value: digital.constellation_calcdist([(0.7071067811865476+0.7071067811865476j), (-0.7071067811865476+0.7071067811865476j), (0.7071067811865476-0.7071067811865476j), (-0.7071067811865476-0.7071067811865476j)], [0, 1, 2, 3], 4, 1, digital.constellation.AMPLITUDE_NORMALIZATION).base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 760
    - 92
    rotation: 0
    state: enabled
- name: fft_0
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: ch_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: Channel at 0 Hz. Neighbour carriers sit at +-25 kHz multiples
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 1,0,1,2
    label: Relative Gain
    label1: ''
    label10: ''''''
    label2: ''''''
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"72 kHz around the channel"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '-20'
    ymin: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 600
    - 428.0
    rotation: 0
    state: enabled
- name: file_src
  id: blocks_file_source
  parameters:
    alias: ''
    comment: |-
