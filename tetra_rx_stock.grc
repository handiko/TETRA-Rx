- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nTETRA TCH/S ACELP decoder -- Embedded Python Block, GNU\
      \ Radio 3.10\n\nInputs (message)\n  'tch'  : f32 PDUs of 484 soft bits = normal-burst\
      \ bits 14..497 of every burst that carries\n           normal training sequence\
      \ 1 (full slot: TCH, or SCH/F signalling). ONE stock\n           Tags To PDU\
      \ cuts them, so block 1 = [0:216] and block 2 = [268:484] always belong\n  \
      \         to the same burst (no pairing between two cutters).\n  'tdma' : dict\
      \ from 'TETRA CRC + Cell Info' after every CRC-good SYNC of the confirmed cell:\n\
      \           tn, fn, mn and slot_bit = absolute soft-bit index where that sync\
      \ burst's slot starts.\nOutput (stream): float32 PCM, 8 kHz.\n\nHow the timeslot\
      \ is known\n  Tags To PDU stamps each PDU with rx_time = tag offset / rate.\
      \ With rate = 2*ch_rate/sps\n  = 36000 bit/s, rx_time*36000 is the absolute\
      \ soft-bit index of the tag. Every cutter sits on\n  the same pol_mul stream,\
      \ so a TCH burst and a SYNC burst share one bit counter:\n      slots = round((tch_slot_start\
      \ - sync_slot_start) / 510)\n      TN = (TN_sync - 1 + slots) mod 4 + 1,  FN\
      \ advances every 4 slots (1..18).\n  A real burst lands on the 510-bit slot\
      \ grid (|error| <= a few bits); correlator false hits\n  land anywhere, so off-grid\
      \ bursts are dropped.\n\ntarget_tn\n   0  auto   : channel-decode every slot,\
      \ play the one with the most good (non-BFI) frames\n   1..4      : play only\
      \ that timeslot\n  -1  all    : play everything (old behaviour; mixes slots,\
      \ for debugging only)\nFrame 18 is the control frame (no traffic); skip_fn18\
      \ drops it.\n\nNeeds tetra_dec.dll (Windows) / libtetra_dec.so next to the generated\
      \ flowgraph .py, exporting\ntetra_cd_init(), tetra_dec_init(), int tetra_cd_frame(short\
      \ soft[432], short serial[276]),\ntetra_dec_frame(short serial[138], short pcm[240]).\n\
      \"\"\"\nimport os\nimport sys\nimport ctypes\nimport threading\nfrom collections\
      \ import deque\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\
      # ---- burst geometry (must match tetra_fec / tetra_dec) -------------------------------------\n\
      SLOT_BITS = 510\nTCH_TAG = 266          # NTS1 tag = first bit after the training\
      \ sequence (slot bit 266)\nPDU_LEN = 484          # slot bits 14..497\nBLK2\
      \ = 268             # block 2 starts at slot bit 282 = 14 + 268\nBLK_LEN = 216\n\
      GRID_TOL = 8           # bits: allowed distance from the slot grid\nREF_MAX_AGE\
      \ = 36000 * 30   # bits (30 s): older SYNC reference is not trusted\nAUTO_WIN\
      \ = 36000 * 2   # bits (2 s) window for the auto selector\nAUTO_MIN_GOOD = 6\
      \      # good frames in the window needed to (keep) select a slot\n\n_SCR_TAPS\
      \ = (32, 26, 23, 22, 16, 12, 11, 10, 8, 7, 5, 4, 2, 1)\n\n\ndef _scr_pm(key,\
      \ n):\n    \"\"\"TETRA scrambler (EN 300 392-2 cl. 8.2.5) as +-1.0 values (bit\
      \ 1 -> -1).\"\"\"\n    reg = ((int(key) << 2) | 3) & 0xFFFFFFFF\n    out = []\n\
      \    for _ in range(n):\n        b = 0\n        for t in _SCR_TAPS:\n      \
      \      b ^= (reg >> (32 - t)) & 1\n        reg = (reg >> 1) | (b << 31)\n  \
      \      out.append(1.0 - 2.0 * b)\n    return out\n\n\ndef abs_bit(meta):\n \
      \   \"\"\"Absolute soft-bit index of the PDU's start tag, from Tags To PDU's\
      \ rx_time.\"\"\"\n    try:\n        t = pmt.dict_ref(meta, pmt.intern('rx_time'),\
      \ pmt.PMT_NIL)\n        if not pmt.is_tuple(t):\n            return None\n \
      \       r = pmt.dict_ref(meta, pmt.intern('sample_rate'), pmt.PMT_NIL)\n   \
      \     rate = pmt.to_double(r) if pmt.is_number(r) else 36000.0\n        sec\
      \ = pmt.to_uint64(pmt.tuple_ref(t, 0))\n        frac = pmt.to_double(pmt.tuple_ref(t,\
      \ 1))\n        return int(round(sec * rate + frac * rate))\n    except Exception:\n\
      \        return None\n\n\ndef slot_position(ref_tn, ref_fn, ref_slot_bit, slot_bit):\n\
      \    \"\"\"TN/FN of the slot starting at slot_bit, given a SYNC burst's TN/FN/slot\
      \ start.\n    Returns (tn, fn, grid_error_bits).\"\"\"\n    d = slot_bit - ref_slot_bit\n\
      \    k = int(round(d / float(SLOT_BITS)))\n    err = d - k * SLOT_BITS\n   \
      \ q = (ref_tn - 1) + k\n    return q % 4 + 1, (ref_fn - 1 + q // 4) % 18 + 1,\
      \ err\n\n\ndef _candidate_dll_dirs():\n    dirs = []\n    main = sys.modules.get('__main__')\n\
      \    f = getattr(main, '__file__', None)\n    if f:\n        dirs.append(os.path.dirname(os.path.abspath(f)))\n\
      \    try:\n        dirs.append(os.path.dirname(os.path.abspath(__file__)))\n\
      \    except NameError:\n        pass\n    dirs.append(os.getcwd())\n    if sys.path\
      \ and sys.path[0]:\n        dirs.append(sys.path[0])\n    out = []\n    for\
      \ d in dirs:\n        d = os.path.normcase(os.path.abspath(d))\n        if d\
      \ not in out:\n            out.append(d)\n    return out\n\n\ndef _say(s):\n\
      \    sys.stdout.write('[TCH/S] ' + s + '\\n')\n    sys.stdout.flush()\n\n\n\
      class blk(gr.sync_block):\n    \"\"\"TETRA TCH/S decoder: timeslot-aware, ETSI\
      \ ACELP via tetra_dec.dll\"\"\"\n\n    def __init__(self, dll_path='', cell_key=0,\
      \ gain_db=0.0, polarity=-1.0,\n                 target_tn=0, skip_fn18=True,\
      \ prefill_ms=180.0):\n        gr.sync_block.__init__(self, name='TETRA TCH/S\
      \ ACELP decoder',\n                               in_sig=None, out_sig=[np.float32])\n\
      \        self.message_port_register_in(pmt.intern('tch'))\n        self.message_port_register_in(pmt.intern('tdma'))\n\
      \        self.set_msg_handler(pmt.intern('tch'), self._on_tch)\n        self.set_msg_handler(pmt.intern('tdma'),\
      \ self._on_tdma)\n\n        self._dll_path = dll_path or ''\n        self._lib\
      \ = None\n        self._lib_failed = False\n        self._dll_lock = threading.Lock()\
      \   # the ETSI code keeps global state: one caller at a time\n\n        self.gain\
      \ = 10.0 ** (float(gain_db) / 20.0)\n        self.polarity = float(polarity)\n\
      \        self.skip_fn18 = bool(skip_fn18)\n        self.prefill = int(8.0 *\
      \ float(prefill_ms))   # samples at 8 kHz\n\n        self._ref = None      \
      \              # (tn, fn, slot_bit) of the last good SYNC\n        self._sel\
      \ = None                    # timeslot being played (auto mode)\n        self._hist\
      \ = {t: deque() for t in (1, 2, 3, 4)}   # (bit, good) per TN, auto mode\n \
      \       self._target = 0\n\n        self._buf = np.zeros(0, dtype=np.float32)\n\
      \        self._buf_lock = threading.Lock()\n        self._playing = False\n\
      \        self.MAX_BUFFER = 8000              # 1 s\n\n        self.n = dict(pdu=0,\
      \ short=0, no_time=0, no_ref=0, off_grid=0, fn18=0)\n        self.n_tn = {t:\
      \ [0, 0, 0] for t in (1, 2, 3, 4)}   # seen, good, played\n        self.n_unknown\
      \ = [0, 0, 0]\n        self._last_report = 0\n\n        self._ck = None\n  \
      \      self.scr = np.ones(2 * BLK_LEN, dtype=np.float32)\n        self.cell_key\
      \ = cell_key\n        self.target_tn = target_tn\n\n    # ------------------------------------------------------------------\
      \ settable parameters\n    @property\n    def cell_key(self):\n        return\
      \ self._ck or 0\n\n    @cell_key.setter\n    def cell_key(self, value):\n  \
      \      v = int(value)\n        if v == 0 or v == self._ck:\n            return\n\
      \        with self._dll_lock:\n            self._ck = v\n            self.scr\
      \ = np.array(_scr_pm(v, 2 * BLK_LEN), dtype=np.float32)\n            if self._lib\
      \ is not None:\n                self._lib.tetra_cd_init()\n                self._lib.tetra_dec_init()\n\
      \            self._sel = None\n        _say('armed for cell key 0x%07X' % v)\n\
      \n    def set_cell_key(self, value):\n        self.cell_key = value\n\n    @property\n\
      \    def target_tn(self):\n        return self._target\n\n    @target_tn.setter\n\
      \    def target_tn(self, value):\n        v = int(value)\n        if v not in\
      \ (-1, 0, 1, 2, 3, 4):\n            v = 0\n        self._target = v\n      \
      \  self._sel = None\n        for h in self._hist.values():\n            h.clear()\n\
      \        _say('timeslot: %s' % {0: 'auto', -1: 'ALL (mixed)'}.get(v, 'TN %d'\
      \ % v))\n\n    def set_target_tn(self, value):\n        self.target_tn = value\n\
      \n    # ------------------------------------------------------------------ DLL\n\
      \    def _ensure_lib(self):\n        if self._lib is not None or self._lib_failed:\n\
      \            return self._lib\n        path = self._dll_path\n        if not\
      \ path:\n            for d in _candidate_dll_dirs():\n                for name\
      \ in ('tetra_dec.dll', 'libtetra_dec.so', 'tetra_dec.so'):\n               \
      \     p = os.path.join(d, name)\n                    if os.path.exists(p):\n\
      \                        path = p\n                        break\n         \
      \       if path:\n                    break\n        if not path:\n        \
      \    self._lib_failed = True\n            _say('tetra_dec.dll not found next\
      \ to the flowgraph: audio stays silent '\n                 '(timeslot statistics\
      \ still print)')\n            return None\n        try:\n            if hasattr(os,\
      \ 'add_dll_directory'):        # Windows: let MinGW runtime DLLs resolve\n \
      \               try:\n                    os.add_dll_directory(os.path.dirname(os.path.abspath(path)))\n\
      \                except OSError:\n                    pass\n            lib\
      \ = ctypes.CDLL(path)\n            i16p = np.ctypeslib.ndpointer(np.int16, ndim=1,\
      \ flags='C_CONTIGUOUS')\n            lib.tetra_cd_frame.argtypes = [i16p, i16p]\n\
      \            lib.tetra_cd_frame.restype = ctypes.c_int\n            lib.tetra_dec_frame.argtypes\
      \ = [i16p, i16p]\n            lib.tetra_dec_frame.restype = None\n         \
      \   lib.tetra_cd_init.restype = None\n            lib.tetra_dec_init.restype\
      \ = None\n            lib.tetra_cd_init()\n            lib.tetra_dec_init()\n\
      \            self._lib = lib\n            _say('loaded %s' % path)\n       \
      \ except (OSError, AttributeError) as e:\n            self._lib_failed = True\n\
      \            _say('failed to load %s: %s' % (path, e))\n        return self._lib\n\
      \n    # ------------------------------------------------------------------ messages\n\
      \    def _on_tdma(self, msg):\n        try:\n            tn = pmt.to_long(pmt.dict_ref(msg,\
      \ pmt.intern('tn'), pmt.PMT_NIL))\n            fn = pmt.to_long(pmt.dict_ref(msg,\
      \ pmt.intern('fn'), pmt.PMT_NIL))\n            sb = pmt.to_long(pmt.dict_ref(msg,\
      \ pmt.intern('slot_bit'), pmt.PMT_NIL))\n        except Exception:\n       \
      \     return\n        if 1 <= tn <= 4 and 1 <= fn <= 18:\n            self._ref\
      \ = (tn, fn, sb)\n\n    def _locate(self, slot_bit):\n        \"\"\"-> (tn,\
      \ fn) or None (unknown) or False (off grid = correlator false hit)\"\"\"\n \
      \       ref = self._ref\n        if ref is None or abs(slot_bit - ref[2]) >\
      \ REF_MAX_AGE:\n            return None\n        tn, fn, err = slot_position(ref[0],\
      \ ref[1], ref[2], slot_bit)\n        if abs(err) > GRID_TOL:\n            return\
      \ False\n        return tn, fn\n\n    def _on_tch(self, msg):\n        self.n['pdu']\
      \ += 1\n        try:\n            b = np.array(pmt.f32vector_elements(pmt.cdr(msg)),\
      \ dtype=np.float32)\n        except Exception:\n            return\n       \
      \ if b.size != PDU_LEN:\n            self.n['short'] += 1\n            return\n\
      \        tag_bit = abs_bit(pmt.car(msg))\n        if tag_bit is None:\n    \
      \        self.n['no_time'] += 1\n            pos = None\n        else:\n   \
      \         pos = self._locate(tag_bit - TCH_TAG)\n            if pos is False:\n\
      \                self.n['off_grid'] += 1\n                return\n         \
      \   if pos is None:\n                self.n['no_ref'] += 1\n        if pos is\
      \ not None and pos[1] == 18 and self.skip_fn18:\n            self.n['fn18']\
      \ += 1\n            return\n        tn = pos[0] if pos else None\n        cnt\
      \ = self.n_tn[tn] if tn else self.n_unknown\n\n        # which slot is played?\n\
      \        target = self._target\n        if target == -1:\n            play =\
      \ True\n        elif tn is None:\n            play = False                 \
      \     # TN unknown: never mix into the audio\n        elif target == 0:\n  \
      \          play = None                       # decided after the channel decode\n\
      \        else:\n            play = (tn == target)\n        if play is False\
      \ and target != 0:\n            cnt[0] += 1                       # counted,\
      \ not decoded\n            self._report()\n            return\n\n        lib\
      \ = self._ensure_lib()\n        slot = np.concatenate((b[:BLK_LEN], b[BLK2:BLK2\
      \ + BLK_LEN]))\n        with self._dll_lock:\n            soft = np.clip(np.round(self.polarity\
      \ * slot * self.scr * 127.0),\n                           -127, 127).astype(np.int16)\n\
      \            if lib is None:\n                good = False\n               \
      \ serial = None\n            else:\n                serial = np.zeros(276, dtype=np.int16)\n\
      \                good = (lib.tetra_cd_frame(soft, serial) == 0)\n          \
      \  cnt[0] += 1\n            cnt[1] += int(good)\n            if play is None:\n\
      \                play = self._auto_select(tn, tag_bit, good)\n            if\
      \ play and serial is not None:\n                pcm = np.zeros(480, dtype=np.int16)\n\
      \                for k in range(2):\n                    fr = np.ascontiguousarray(serial[138\
      \ * k:138 * (k + 1)])\n                    out = np.zeros(240, dtype=np.int16)\n\
      \                    lib.tetra_dec_frame(fr, out)\n                    pcm[240\
      \ * k:240 * (k + 1)] = out\n                cnt[2] += 1\n                self._push(pcm.astype(np.float32)\
      \ / 32768.0 * self.gain)\n        self._report()\n\n    def _auto_select(self,\
      \ tn, bit, good):\n        \"\"\"Called with _dll_lock held. Returns True if\
      \ this frame should be played.\"\"\"\n        h = self._hist[tn]\n        h.append((bit,\
      \ good))\n        for q in self._hist.values():\n            while q and bit\
      \ - q[0][0] > AUTO_WIN:\n                q.popleft()\n        score = {t: sum(g\
      \ for _, g in q) for t, q in self._hist.items()}\n        sel = self._sel\n\
      \        if sel is None or score[sel] < AUTO_MIN_GOOD:\n            best = max(score,\
      \ key=score.get)\n            new = best if score[best] >= AUTO_MIN_GOOD else\
      \ None\n            if new != sel:\n                self._sel = new\n      \
      \          if new is not None and self._lib is not None:\n                 \
      \   self._lib.tetra_dec_init()       # fresh speech decoder for a new call\n\
      \                _say('auto: %s' % ('playing TN %d' % new if new else 'no call\
      \ heard'))\n        return tn == self._sel\n\n    def _push(self, out):\n  \
      \      with self._buf_lock:\n            self._buf = np.concatenate((self._buf,\
      \ out))\n            if self._buf.size > self.MAX_BUFFER:\n                self._buf\
      \ = self._buf[-self.MAX_BUFFER:]\n\n    def _report(self):\n        tot = self.n['pdu']\n\
      \        if tot - self._last_report < 200:\n            return\n        self._last_report\
      \ = tot\n        per = '  '.join('TN%d %d/%d/%d' % (t, *self.n_tn[t]) for t\
      \ in (1, 2, 3, 4))\n        _say('NTS1 bursts %d: %s  unknownTN %d/%d/%d  (seen/good/played)\
      \  '\n             'dropped: off-grid %d, FN18 %d, no SYNC ref %d, bad len %d%s'\
      \ % (\n                 tot, per, *self.n_unknown, self.n['off_grid'], self.n['fn18'],\n\
      \                 self.n['no_ref'], self.n['short'],\n                 ', NO\
      \ rx_time (check Tags To PDU rate)' if self.n['no_time'] else ''))\n\n    #\
      \ ------------------------------------------------------------------ audio out\n\
      \    def work(self, input_items, output_items):\n        out = output_items[0]\n\
      \        n = 0\n        with self._buf_lock:\n            if not self._playing\
      \ and self._buf.size >= self.prefill:\n                self._playing = True\
      \              # start only with a cushion queued\n            if self._playing:\n\
      \                n = min(out.size, self._buf.size)\n                if n:\n\
      \                    out[:n] = self._buf[:n]\n                    self._buf\
      \ = self._buf[n:]\n                if self._buf.size == 0:\n               \
      \     self._playing = False         # ran dry: re-buffer before playing again\n\
      \        if n < out.size:\n            out[n:] = 0.0\n        return out.size\n"
    affinity: ''
    alias: ''
    cell_key: cell_key
    comment: Timeslot-aware TCH/S decoder. Needs tetra_dec.dll next to the generated
      .py
    dll_path: ''''''
    gain_db: '0.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    polarity: '-1.0'
    prefill_ms: '180.0'
    skip_fn18: 'True'
    target_tn: target_tn
  states:
