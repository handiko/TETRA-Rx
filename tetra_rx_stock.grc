- name: tetra_fec
  id: epy_module
  parameters:
    alias: ''
    comment: 'Tables for the stock FEC blocks: scrambler, interleaver, FSM, Viterbi
      table, cut offsets'
    source_code: "\"\"\"\ntetra_fec - Python Module block (id: tetra_fec). Tables\
      \ only: no signal processing runs here.\nEvery number below is used as a parameter\
      \ of a STOCK block; the processing itself happens in\nMultiply Const (descramble),\
      \ Trellis Permutation (de-interleave), Deinterleave/Interleave +\nNull Source\
      \ (de-puncture) and Viterbi Combo (decode).\n\nSpec: ETSI EN 300 392-2 clause\
      \ 8 (channel coding), cross-checked against the original EPB,\nwhich decoded\
      \ live cells (MCC 510 MNC 1945).\n\"\"\"\nimport numpy as np\n\n# ----------------------------------------------------------------\
      \ frame sync\n# Correlate Access Code - Tag puts its tag on the FIRST bit AFTER\
      \ the code.\n# Measured in GNU Radio 3.10.9: tag offset = code start + code\
      \ length.\nY_CODE = '11000001100111001110100111000001100111'   # 38-bit synchronisation\
      \ training seq (sync burst)\nP_CODE = '0111101001000011011110'             \
      \      # 22-bit normal training seq 2 (two half-slot blocks)\n# slot positions\
      \ [bits]: sync burst  BSCH 94..213, y 214..251, SCH/HD 282..497\n#         \
      \               normal burst blk1 14..229, p 244..265,  blk2 282..497\nY_TAG\
      \ = 214 + 38      # = 252 : y tag lands here\nP_TAG = 244 + 22      # = 266\
      \ : p tag lands here\nD_BSCH = Y_TAG - 94   # = 158 : delay the DATA by this\
      \ so the y tag sits on the BSCH start\nD_SB2 = 282 - Y_TAG   # =  30 : delay\
      \ the y TAG by this so it sits on sync-burst block 2\nD_NB1 = P_TAG - 14   \
      \ # = 252 : delay the DATA by this so the p tag sits on normal-burst block 1\n\
      D_NB2 = 282 - P_TAG   # =  16 : delay the p TAG by this so it sits on normal-burst\
      \ block 2\n\n# ----------------------------------------------------------------\
      \ scrambler (cl. 8.2.5)\n_SCR_TAPS = (32, 26, 23, 22, 16, 12, 11, 10, 8, 7,\
      \ 5, 4, 2, 1)\n\n\ndef cell_key(mcc, mnc, cc):\n    \"\"\"30-bit extended colour\
      \ code = MCC(10) | MNC(14) | colour code(6)\"\"\"\n    return ((mcc & 0x3FF)\
      \ << 20) | ((mnc & 0x3FFF) << 6) | (cc & 0x3F)\n\n\ndef scr_pm(key, n):\n  \
      \  \"\"\"n scrambling values as +-1.0 (bit 1 -> -1). Multiply soft bits by this\
      \ to descramble.\n    key = cell_key(mcc, mnc, cc); key 0 is the fixed BSCH\
      \ scrambler.\"\"\"\n    reg = ((int(key) << 2) | 3) & 0xFFFFFFFF\n    out =\
      \ []\n    for _ in range(n):\n        b = 0\n        for t in _SCR_TAPS:\n \
      \           b ^= (reg >> (32 - t)) & 1\n        reg = (reg >> 1) | (b << 31)\n\
      \        out.append(1.0 - 2.0 * b)\n    return out\n\n\nBSCH_SCR = scr_pm(0,\
      \ 120)\n\n# ----------------------------------------------------------------\
      \ block (de)interleaver (cl. 8.2.4.1)\n# Trellis Permutation computes out[i]\
      \ = in[TABLE[i]] (verified), which is exactly the de-interleaver:\n# type-3\
      \ bit i (1..K) was sent as type-4 bit k = 1 + (a*i mod K)\n\n\ndef deint_table(K,\
      \ a):\n    return [(a * i) % K for i in range(1, K + 1)]\n\n\nDEINT_120 = deint_table(120,\
      \ 11)    # BSCH\nDEINT_216 = deint_table(216, 101)   # SCH/HD, BNCH, STCH\n\n\
      # ---------------------------------------------------------------- RCPC rate\
      \ 2/3 (cl. 8.2.3.1.3)\n# From the 1/4 mother code keep mother bits 1, 2, 5 of\
      \ every 8 (2 info bits -> 3 sent bits).\n# De-puncture = Deinterleave(3 outputs)\
      \ -> Interleave(8 inputs), received bits on inputs 0, 1, 4,\n# a Null Source\
      \ (0.0 = erasure, no information) on inputs 2, 3, 5, 6, 7.\nPUNCT_KEEP = (0,\
      \ 1, 4)\n\n# ----------------------------------------------------------------\
      \ mother code (cl. 8.2.3.1.1)\n# K = 5, rate 1/4: G1 = 1+D+D^4, G2 = 1+D^2+D^3+D^4,\
      \ G3 = 1+D+D^2+D^4, G4 = 1+D+D^3+D^4.\n# The FSM is written out explicitly (next-state\
      \ / output tables) so there is no octal\n# generator-order convention to get\
      \ wrong. Output symbol = g1 g2 g3 g4 (g1 = MSB).\n_TAPS = ((0, 3), (1, 2, 3),\
      \ (0, 1, 3), (0, 2, 3))   # delay cells D1..D4 = state bits 0..3\nNS, OS = [],\
      \ []\nfor _s in range(16):\n    _d = [(_s >> _i) & 1 for _i in range(4)]\n \
      \   for _u in (0, 1):\n        _o = 0\n        for _taps in _TAPS:\n       \
      \     _b = _u\n            for _t in _taps:\n                _b ^= _d[_t]\n\
      \            _o = (_o << 1) | _b\n        NS.append(((_s << 1) | _u) & 15)\n\
      \        OS.append(_o)\nFSM_ARGS = (2, 16, 16, NS, OS)     # trellis.fsm(I,\
      \ S, O, NS, OS)\n\n# Viterbi Combo, Euclidean metric, dimension 4: symbol o\
      \ -> 4 coded bits as +-1 (+1 = bit 1),\n# the same sign convention as the soft\
      \ bits after the polarity multiplier.\nVIT_TABLE = []\nfor _o in range(16):\n\
      \    VIT_TABLE += [2.0 * ((_o >> (3 - _g)) & 1) - 1.0 for _g in range(4)]\n\n\
      # trellis steps per block = type-2 bits = info + 16 CRC + 4 tail\nBSCH_STEPS\
      \ = 60 + 16 + 4      # 80  -> 120 sent bits\nHD_STEPS = 124 + 16 + 4       #\
      \ 144 -> 216 sent bits\n\n# ----------------------------------------------------------------\
      \ SCH/F (full-slot signalling)\n# 268 info + 16 CRC + 4 tail = 288 type-2 bits\
      \ -> 432 sent bits; interleaver a = 103\nDEINT_432 = deint_table(432, 103)\n\
      F_STEPS = 268 + 16 + 4\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 12]
    rotation: 0
    state: enabled
