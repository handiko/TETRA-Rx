options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'TETRA DL: RTL-SDR, stock front end, stock frame sync, stock descramble/deinterleave/depuncture/Viterbi;
      EPBs for CRC + PDU parsing and timeslot-aware TCH/S voice'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: tetra_rx_live_osmo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: TETRA RX - stock FEC chain, cell info (live, osmocom RTL-SDR)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: algorithm
  id: variable_adaptive_algorithm
  parameters:
    comment: ''
    cons: constellation
    delta: '10.0'
    ffactor: '0.99'
    modulus: '1'
    step_size: '.005'
    type: cma
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2264, 12]
    rotation: 0
    state: true
- name: cell_key
  id: variable
  parameters:
    comment: 'Extended colour code MCC<<20|MNC<<6|CC. Set at run time by

      Message Pair to Var from the decoded SYNC (0 = not known yet)'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1720, 12]
    rotation: 0
    state: enabled
- name: ch_rate
  id: variable
  parameters:
    comment: 72 kS/s = 4 samples/symbol
    value: samp_rate/decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 92]
    rotation: 0
    state: enabled
- name: chan_cut
  id: variable
  parameters:
    comment: 'Channel filter -6 dB point. TETRA occupies +-12.15 kHz; neighbours start
      at

      +-12.85 kHz (25 kHz raster). 16 kHz alone let them bias the FLL by kHz'
    value: 13.5e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1856, 92]
    rotation: 0
    state: enabled
- name: constellation
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[1+1j, -1+1j, 1-1j, -1-1j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 2, 3]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2264, 112]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: 1.152 MS/s / 16 = 72 kS/s
    value: '16'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: dqpsk_diff
  id: variable
  parameters:
    comment: 'Phase CHANGE per symbol -> dibit (EN 300 392-2 Table 5.x):

      +pi/4=00  +3pi/4=01  -pi/4=10  -3pi/4=11  (index = dibit value)'
    value: digital.constellation_calcdist([(0.7071067811865476+0.7071067811865476j),
      (-0.7071067811865476+0.7071067811865476j), (0.7071067811865476-0.7071067811865476j),
      (-0.7071067811865476-0.7071067811865476j)], [0, 1, 2, 3], 4, 1, digital.constellation.AMPLITUDE_NORMALIZATION).base()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 92]
    rotation: 0
    state: enabled
- name: f_scr
  id: variable
  parameters:
    comment: SCH/F descrambling vector (+-1), 432 bits, follows cell_key
    value: tetra_fec.scr_pm(cell_key, 432)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1720, 172]
    rotation: 0
    state: enabled
- name: fine_hz
  id: variable_qtgui_range
  parameters:
    comment: Nudges the channel by a few kHz. Leave at 0 once tetra_freq and ppm are
      right.
    gui_hint: 0,2,1,1
    label: Fine tune [kHz]
    min_len: '500'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: (-samp_rate/2)/1e3
    step: '1'
    stop: (samp_rate/2)/1e3
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 12.0]
    rotation: 0
    state: enabled
- name: fll_range_hz
  id: variable
  parameters:
    comment: 'Largest offset the FLL may correct [Hz]. Its built-in range is +-36
      kHz (half the

      sample rate); once parked there it can never pull back. 8 kHz is ample: the
      loop

      pulls in about +-6 kHz, and ppm should take care of the rest.'
    value: 8e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2240, 440.0]
    rotation: 0
    state: enabled
- name: hd_scr
  id: variable
  parameters:
    comment: SCH/HD + BNCH descrambling vector (+-1), follows cell_key
    value: tetra_fec.scr_pm(cell_key, 216)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 104.0]
    rotation: 0
    state: enabled
- name: lo_offset
  id: variable
  parameters:
    comment: 'Tuner sits this far below the channel: keeps it off the RTL DC spike
      / LO leakage'
    value: 0*150e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 128.0]
    rotation: 0
    state: enabled
- name: nfilts
  id: variable
  parameters:
    comment: Polyphase clock-sync filter arms
    value: '32'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 92]
    rotation: 0
    state: enabled
- name: pol
  id: variable_qtgui_chooser
  parameters:
    comment: 'Sign convention between the soft decoder and the correlators / Viterbi
      table.

      "normal" is verified with tetra_testgen.py. Flip only if "no sync seen" persists

      while the red constellation is clean.'
    gui_hint: 3,0,1,1
    label: Soft-bit polarity
    label0: normal
    label1: inverted
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: '1.0'
    option1: '-1.0'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QHBoxLayout
    type: real
    value: '1.0'
    widget: radio_buttons
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1976, 12]
    rotation: 0
    state: enabled
- name: ppm
  id: variable_qtgui_range
  parameters:
    comment: 'RTL-SDR crystal correction, applied in the dongle (tuner AND sample
      clock).

      35 = 10 + 25: two cells both read 10 kHz low at 10 ppm. If nothing decodes,
      try -15.

      TCXO dongles (RTL-SDR Blog v3/v4): 0..1.

      Fine-calibrate: add the "ppm to add" readout until the offset is < ~300 Hz.'
    gui_hint: 0,1,1,1
    label: Freq corr [ppm]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-60'
    step: '0.5'
    stop: '60'
    value: '34'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1180, 12]
    rotation: 0
    state: enabled
- name: rf_fc
  id: variable
  parameters:
    comment: 'Frequency the RTL-SDR is tuned to: lo_offset below the channel

      (keeps the dongle DC spike out of the TETRA channel).'
    value: tetra_freq - lo_offset
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 144.0]
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: RTL-SDR gain. Your gqrx LNA was 25.6 dB. Back off if the FFT shows a
      raised floor / images
    gui_hint: 0,0,1,1
    label: RF gain [dB]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '49.6'
    value: '25.4'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 12]
    rotation: 0
    state: enabled
- name: rrc_taps
  id: variable
  parameters:
    comment: Matched RRC (alpha 0.35) for the polyphase clock sync
    value: firdes.root_raised_cosine(nfilts, nfilts*sps, 1.0, 0.35, 11*sps*nfilts)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'RTL rate 1.152 MS/s = 64 x 18 kBd: one integer /16 -> 4 sps'
    value: 1.152e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: 'TETRA: 18 ksym/s pi/4-DQPSK, RRC alpha 0.35'
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 12]
    rotation: 0
    state: enabled
- name: target_tn
  id: variable_qtgui_chooser
  parameters:
    comment: auto = play the timeslot with the most good (non-BFI) speech frames
    gui_hint: 3,1,1,2
    label: Voice timeslot
    label0: ''
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    labels: '[''auto'', ''TN1'', ''TN2'', ''TN3'', ''TN4'', ''all (mixed)'']'
    num_opts: '0'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2, 3, 4, -1]'
    orient: Qt.QHBoxLayout
    type: int
    value: '0'
    widget: radio_buttons
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2120, 96]
    rotation: 0
    state: enabled
- name: tetra_freq
  id: variable
  parameters:
    comment: 'TETRA DL carrier [Hz], TRUE frequency as announced in SYSINFO.

      MCC 510 MNC 1945 cells seen: 390.625 (recording), 393.0750 (LA 105), 393.3000
      (LA 102)'
    value: tetra_freq_entry*1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: tetra_freq_entry
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: ''
    label: TETRA Freq (MHz)
    type: real
    value: '390.225'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 184.0]
    rotation: 0
    state: enabled
- name: vv_len
  id: variable
  parameters:
    comment: 4th-power derotator averaging length [symbols] (7 ms)
    value: '128'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1856, 12]
    rotation: 0
    state: enabled
- name: add_blk1
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 924]
    rotation: 0
    state: enabled
- name: add_blk2
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '3'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 760]
    rotation: 0
    state: enabled
- name: add_bsch
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: data + 0 = data; tags from both inputs survive
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 636]
    rotation: 0
    state: enabled
- name: add_tch
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: data + 0 = data; tags from both inputs survive
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 1072.0]
    rotation: 0
    state: enabled
- name: analog_agc_xx_0
  id: analog_agc_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gain: '1.0'
    max_gain: '65536'
    maxoutbuf: '0'
    minoutbuf: '0'
    rate: 10e-3
    reference: '0.25'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 300.0]
    rotation: 0
    state: enabled
- name: audio_sink_0
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_name: ''
    num_inputs: '2'
    ok_to_block: 'True'
    samp_rate: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 1112.0]
    rotation: 0
    state: enabled
- name: bsch_deint
  id: trellis_permutation
  parameters:
    affinity: ''
    alias: ''
    comment: 'SOFT DE-INTERLEAVE: out[i] = in[(a*(i+1)) mod K]'
    interleaver_size: '120'
    maxoutbuf: '0'
    minoutbuf: '0'
    syms_per_block: '1'
    table: tetra_fec.DEINT_120
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 1552.0]
    rotation: 0
    state: enabled
- name: bsch_descr
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'SOFT DESCRAMBLE: x (+-1) per bit.

      Changing k takes effect between whole vectors'
    const: tetra_fec.BSCH_SCR
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 1560.0]
    rotation: 0
    state: enabled
- name: bsch_dp3
  id: blocks_deinterleave
  parameters:
    affinity: ''
    alias: ''
    blocksize: '1'
    comment: 'DE-PUNCTURE (1/2): split every 3 received bits'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '3'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1024, 1560.0]
    rotation: 0
    state: enabled
- name: bsch_dp8
  id: blocks_interleave
  parameters:
    affinity: ''
    alias: ''
    blocksize: '1'
    comment: 'DE-PUNCTURE (2/2): rebuild 8 mother bits,

      0.0 (erasure) where the TX punctured'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '8'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1192, 1552.0]
    rotation: 0
    state: enabled
- name: bsch_erase
  id: blocks_null_source
  parameters:
    affinity: ''
    alias: ''
    bus_structure_source: '[[0,],]'
    comment: 'Erasures for de-puncturing (0.0 = no information).

      One per chain: a shared source would couple the two chains'' buffers'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '1'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1032, 1648.0]
    rotation: 0
    state: enabled
- name: bsch_p2s
  id: pdu_pdu_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: BSCH cuts -> stream (whole blocks only, so everything below stays aligned)
    maxoutbuf: '0'
    minoutbuf: '0'
    tag: packet_len
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [48, 1552.0]
    rotation: 0
    state: enabled
- name: bsch_s2t
  id: blocks_stream_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    len_tag_key: '"blk"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: tetra_fec.BSCH_STEPS
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1624, 1560.0]
    rotation: 0
    state: enabled
- name: bsch_s2v
  id: blocks_stream_to_vector
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '120'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 1560.0]
    rotation: 0
    state: enabled
- name: bsch_t2p
  id: pdu_tagged_stream_to_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    tag: blk
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1832, 1560.0]
    rotation: 0
    state: enabled
- name: bsch_v2s
  id: blocks_vector_to_stream
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '120'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [632, 1560.0]
    rotation: 0
    state: enabled
- name: bsch_vit
  id: trellis_viterbi_combined_xx
  parameters:
    affinity: ''
    alias: ''
    block_size: tetra_fec.BSCH_STEPS
    comment: 'SOFT VITERBI: K=5 rate-1/4 mother code, terminated (start/end state
      0)'
    dim: '4'
    final_state: '0'
    fsm_args: 2, 16, 16, tetra_fec.NS, tetra_fec.OS
    init_state: '0'
    maxoutbuf: '0'
    metric_type: digital.TRELLIS_EUCLIDEAN
    minoutbuf: '0'
    out_type: b
    table: tetra_fec.VIT_TABLE
    type: f
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1368, 1552.0]
    rotation: 0
    state: enabled
- name: cell_to_var
  id: blocks_msgpair_to_var
  parameters:
    affinity: ''
    alias: ''
    comment: Sets variable cell_key -> hd_scr -> SCH/HD descrambler
    target: cell_key
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2320, 1632.0]
    rotation: 0
    state: enabled
- name: chan_lpf
  id: fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Tight channel filter at 72 kS/s (~80 taps, cheap): keeps the 25 kHz

      neighbours out of the FLL band-edge filters (measured: a +9 dB neighbour

      otherwise pulls the FLL ~2 kHz off)'
    decim: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_delay: '0'
    taps: firdes.low_pass(1.0, ch_rate, chan_cut, 3e3)
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [344, 312.0]
    rotation: 0
    state: enabled
- name: clock_0
  id: digital_pfb_clock_sync_xxx
  parameters:
    affinity: ''
    alias: ''
    comment: Matched RRC + symbol timing in one block, 4 sps -> 1 sps
    filter_size: nfilts
    init_phase: nfilts/2
    loop_bw: '0.0628'
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    osps: '1'
    sps: sps
    taps: rrc_taps
    type: ccf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 232.0]
    rotation: 0
    state: enabled
- name: const_0
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '0.5'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"red"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: "Blue: symbols after clock sync + equaliser: a THIN RING = timing locked.\n\
      Red: phase steps after the 4th-power derotator = what the decoder sees.\n  4\
      \ tight clusters at +-45/+-135 deg = healthy.\nGreen: the same steps BEFORE\
      \ the derotator. Their rotation = carrier left over\n  after the FLL (also on\
      \ the number sink). > ~20 deg rotation: fix ppm."
    grid: 'True'
    gui_hint: 1,2,1,1
    label1: symbol
    label10: ''
    label2: phase steps -> decoder
    label3: raw phase steps
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '1'
    marker10: '0'
    marker2: '0'
    marker3: '0'
