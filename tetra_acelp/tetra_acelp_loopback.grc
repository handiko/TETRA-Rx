- name: tchs_dec
  id: epy_block
  parameters:
    alias: ''
    comment: |-
      EPB 3  ETSI cdecoder: 432 soft symbols -> 2 x (BFI + 137 bits)
      out 1 = BFI per 60 ms block
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      """
      TCH/S Channel Decoder -- Embedded Python Block (GNU Radio 3.10). ETSI 'cdecoder' as a block.

      Input  0 : float vector[432] = one received TCH/S block, SOFT values, positive = bit 0
                 (noiseless: exactly +-1.0 as the encoder sent them)
      Output 0 : short vector[276] = two serial frames (2 x [BFI + 137 bits])
      Output 1 : float             = BFI of this 60 ms block: 1.0 if the class-2 CRC failed

      soft_scale: input value -> ETSI soft integer, round(soft_scale * x) clipped to +-127.
        Default 64: a clean +-1.0 becomes +-64, and noisy samples up to +-2.0 keep their
        reliability instead of being clipped at 127. Measured on 19 s of speech: about 30 %
        fewer bad frames than 127 at Es/N0 = -1 dB, and still bit-exact with the ETSI programs
        on a clean channel (only signs matter there). 127 = ETSI's own +-127 exactly.

      Inside: de-interleave, Viterbi decoding of classes 1 and 2 (soft), CRC check of class 2
      -> Bad Frame Indicator (the speech decoder then conceals both frames), class 0 by sign.

      Why an EPB: no stock block for TETRA's RCPC Viterbi + CRC/BFI. Code: tetra_dec.dll.
      """
      import atexit
      import ctypes
      import glob
      import os
      import shutil
      import sys
      import tempfile
      import time

      import numpy as np

      I16 = np.ctypeslib.ndpointer(np.int16, flags='C_CONTIGUOUS')


      def load_private(lib_path, base):
          """Find tetra_enc / tetra_dec (.dll on Windows) and load a PRIVATE COPY of it.

          The ETSI codec keeps its state in C statics, and Init_*() does not clear all of
          them. A private copy per block gives every block its own fresh state, exactly like
          starting the ETSI .exe anew, even when a flowgraph contains two decoders.
          Search order: lib_path (file or folder), the flowgraph's folder, the current folder, PATH.
          """
          names = (base + '.dll', 'lib' + base + '.dll', 'lib' + base + '.so', 'lib' + base + '.dylib')
          cands = []
          if lib_path and os.path.isfile(lib_path):
              cands.append(lib_path)
          dirs = ([lib_path] if lib_path and os.path.isdir(lib_path) else []) + \
                 [os.path.dirname(os.path.abspath(sys.argv[0] or '.')), os.getcwd()] + \
                 os.environ.get('PATH', '').split(os.pathsep)
          cands += [os.path.join(d, n) for d in dirs if d for n in names]
          src = next((p for p in cands if os.path.isfile(p)), None)
          if src is None:
              raise RuntimeError('[TETRA codec] cannot find %s.dll. Put it next to the .grc file or set '
                                 'lib_path. Tried: %s' % (base, ', '.join(cands[:8]) + ' ...'))
          now = time.time()
          for old in glob.glob(os.path.join(tempfile.gettempdir(), 'tetra_codec_*')):
              try:                                            # copies left by crashed runs, > 1 h old
                  if now - os.path.getmtime(old) > 3600:
                      shutil.rmtree(old, ignore_errors=True)
              except OSError:
                  pass
          tmp = tempfile.mkdtemp(prefix='tetra_codec_')
          dst = os.path.join(tmp, os.path.basename(src))
          shutil.copyfile(src, dst)
          atexit.register(shutil.rmtree, tmp, True)
          lib = ctypes.CDLL(dst)
          if lib.tetra_wrap_version() != 1:
              raise RuntimeError('[TETRA codec] %s: unexpected wrapper version' % src)
          return lib, src


      def in_grc():
          """True while GRC (editor or grcc) instantiates the block only to read its ports."""
          return 'gnuradio.grc' in sys.modules


      from gnuradio import gr


      class blk(gr.sync_block):
          """TCH/S Channel Decoder (ETSI cdecoder): 432 soft symbols -> 2 x (BFI + 137 bits), BFI"""

          def __init__(self, lib_path='', soft_scale=64.0):
              gr.sync_block.__init__(self, name='TCH/S Channel Decoder',
                                     in_sig=[(np.float32, 432)], out_sig=[(np.int16, 276), np.float32])
              self.soft_scale = float(soft_scale)
              self.lib = None
              self._q = np.zeros(432, np.int16)
              if in_grc():
                  return
              self.lib, src = load_private(lib_path, 'tetra_dec')
              self.lib.tetra_cd_frame.argtypes = [I16, I16]
              self.lib.tetra_cd_frame.restype = ctypes.c_int
              self.lib.tetra_cd_init()
              print('[TCH/S dec] ETSI channel decoder loaded from %s' % src, flush=True)

          def work(self, input_items, output_items):
              x, ser, bfi = input_items[0], output_items[0], output_items[1]
              for k in range(len(x)):
                  np.clip(np.rint(x[k] * self.soft_scale), -127, 127, out=self._q, casting='unsafe')
                  bfi[k] = self.lib.tetra_cd_frame(self._q, ser[k])
              return len(x)
    lib_path: lib_path
    soft_scale: '64.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 640
    rotation: 0
    state: enabled
