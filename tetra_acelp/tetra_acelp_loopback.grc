- name: tchs_enc
  id: epy_block
  parameters:
    alias: ''
    comment: |-
      EPB 2  ETSI ccoder: 2 x 137 bits -> 432 symbols
      (+1 = bit 0, -1 = bit 1), 7.2 kbit/s
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      """
      TCH/S Channel Encoder -- Embedded Python Block (GNU Radio 3.10). ETSI 'ccoder' as a block.

      Input  0 : short vector[276] = TWO serial frames (2 x [BFI + 137 bits]) = 60 ms
      Output 0 : float vector[432] = one TCH/S block, interleaved, as BPSK-style symbols:
                 +1.0 = bit 0, -1.0 = bit 1 (ccoder writes +127 / -127)

      What happens inside (ETSI EN 300 395-2 clause 5): the 2 x 137 bits are sorted by
      sensitivity into class 0 (102 bits, sent unprotected), class 1 (112 bits) and
      class 2 (60 bits + 8-bit CRC + 4 tail bits). Classes 1 and 2 go through the 16-state
      RCPC convolutional code (K = 5, punctured to rates 2/3 and 8/18), giving 102 + 168 +
      162 = 432 bits, then a 24 x 18 block interleaver. 432 bits per 60 ms = 7.2 kbit/s.

      Why an EPB: TETRA's RCPC puncturing, class ordering and CRC have no stock blocks.
      Code: tetra_enc.dll (bit-exact ETSI C), private copy per block.
      """
      import atexit
      import ctypes
      import glob
      import os
      import shutil
      import sys
      import tempfile
      import time

      import numpy as np

      I16 = np.ctypeslib.ndpointer(np.int16, flags='C_CONTIGUOUS')


      def load_private(lib_path, base):
          """Find tetra_enc / tetra_dec (.dll on Windows) and load a PRIVATE COPY of it.

          The ETSI codec keeps its state in C statics, and Init_*() does not clear all of
          them. A private copy per block gives every block its own fresh state, exactly like
          starting the ETSI .exe anew, even when a flowgraph contains two decoders.
          Search order: lib_path (file or folder), the flowgraph's folder, the current folder, PATH.
          """
          names = (base + '.dll', 'lib' + base + '.dll', 'lib' + base + '.so', 'lib' + base + '.dylib')
          cands = []
          if lib_path and os.path.isfile(lib_path):
              cands.append(lib_path)
          dirs = ([lib_path] if lib_path and os.path.isdir(lib_path) else []) + \
                 [os.path.dirname(os.path.abspath(sys.argv[0] or '.')), os.getcwd()] + \
                 os.environ.get('PATH', '').split(os.pathsep)
          cands += [os.path.join(d, n) for d in dirs if d for n in names]
          src = next((p for p in cands if os.path.isfile(p)), None)
          if src is None:
              raise RuntimeError('[TETRA codec] cannot find %s.dll. Put it next to the .grc file or set '
                                 'lib_path. Tried: %s' % (base, ', '.join(cands[:8]) + ' ...'))
          now = time.time()
          for old in glob.glob(os.path.join(tempfile.gettempdir(), 'tetra_codec_*')):
              try:                                            # copies left by crashed runs, > 1 h old
                  if now - os.path.getmtime(old) > 3600:
                      shutil.rmtree(old, ignore_errors=True)
              except OSError:
                  pass
          tmp = tempfile.mkdtemp(prefix='tetra_codec_')
          dst = os.path.join(tmp, os.path.basename(src))
          shutil.copyfile(src, dst)
          atexit.register(shutil.rmtree, tmp, True)
          lib = ctypes.CDLL(dst)
          if lib.tetra_wrap_version() != 1:
              raise RuntimeError('[TETRA codec] %s: unexpected wrapper version' % src)
          return lib, src


      def in_grc():
          """True while GRC (editor or grcc) instantiates the block only to read its ports."""
          return 'gnuradio.grc' in sys.modules


      from gnuradio import gr


      class blk(gr.sync_block):
          """TCH/S Channel Encoder (ETSI ccoder): 2 x 138 serial words -> 432 symbols (+1 = bit 0)"""

          def __init__(self, lib_path=''):
              gr.sync_block.__init__(self, name='TCH/S Channel Encoder',
                                     in_sig=[(np.int16, 276)], out_sig=[(np.float32, 432)])
              self.lib = None
              self._blk = np.zeros(432, np.int16)
              if in_grc():
                  return
              self.lib, src = load_private(lib_path, 'tetra_enc')
              self.lib.tetra_cc_frame.argtypes = [I16, I16]
              self.lib.tetra_cc_init()
              print('[TCH/S enc] ETSI channel encoder loaded from %s' % src, flush=True)

          def work(self, input_items, output_items):
              x, y = input_items[0], output_items[0]
              for k in range(len(x)):
                  self.lib.tetra_cc_frame(x[k], self._blk)
                  y[k] = self._blk * np.float32(1.0 / 127.0)
              return len(x)
    lib_path: lib_path
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1560
    - 224
    rotation: 0
    state: enabled
