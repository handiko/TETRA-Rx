- name: resamp_in
  id: rational_resampler_xxx
  parameters:
    alias: ''
    comment: |-
      wav_rate -> 8 kHz. At 8 kHz the taps are [1.0]: a true
      pass-through (1:1 with default taps would still low-pass filter)
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    interp: int(samp_rate) // rs_g
    decim: int(wav_rate) // rs_g
    taps: '[1.0] if int(wav_rate) == int(samp_rate) else []'
    fbw: '0'
    type: fff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 240
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle
  parameters:
    alias: ''
    comment: |-
      BYPASSED: the sound card is the clock.
      Enable this only if you disable the speaker (two clocks fight)
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    vlen: '1'
    ignoretag: 'True'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 400
    - 240
    rotation: 0
    state: bypassed
