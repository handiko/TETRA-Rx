- name: acelp_enc
  id: epy_block
  parameters:
    alias: ''
    comment: |-
      EPB 1  ETSI scoder: 240 PCM -> BFI + 137 bits
      (+ local synthesis on out 1)
    affinity: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    _source_code: |
      """
      ACELP Speech Encoder -- Embedded Python Block (GNU Radio 3.10). ETSI 'scoder' as a block.

      Input  0 : short vector[240] = one 30 ms speech frame, 16-bit PCM at 8 kHz
      Output 0 : short vector[138] = serial frame, BFI (=0) + 137 bits, one bit (0/1) per word
      Output 1 : short vector[240] = the encoder's local synthesis: what any decoder fed the
                 same bits without errors must output, sample for sample

      Why an EPB: ACELP analysis (LPC/LSP quantisation, pitch and algebraic codebook search)
      has no stock block. The bit-exact ETSI EN 300 395-2 C code does it, loaded from
      tetra_enc.dll with ctypes (a private copy per block, so state is never shared).
      """
      import atexit
      import ctypes
      import glob
      import os
      import shutil
      import sys
      import tempfile
      import time

      import numpy as np

      I16 = np.ctypeslib.ndpointer(np.int16, flags='C_CONTIGUOUS')


      def load_private(lib_path, base):
          """Find tetra_enc / tetra_dec (.dll on Windows) and load a PRIVATE COPY of it.

          The ETSI codec keeps its state in C statics, and Init_*() does not clear all of
          them. A private copy per block gives every block its own fresh state, exactly like
          starting the ETSI .exe anew, even when a flowgraph contains two decoders.
          Search order: lib_path (file or folder), the flowgraph's folder, the current folder, PATH.
          """
          names = (base + '.dll', 'lib' + base + '.dll', 'lib' + base + '.so', 'lib' + base + '.dylib')
          cands = []
          if lib_path and os.path.isfile(lib_path):
              cands.append(lib_path)
          dirs = ([lib_path] if lib_path and os.path.isdir(lib_path) else []) + \
                 [os.path.dirname(os.path.abspath(sys.argv[0] or '.')), os.getcwd()] + \
                 os.environ.get('PATH', '').split(os.pathsep)
          cands += [os.path.join(d, n) for d in dirs if d for n in names]
          src = next((p for p in cands if os.path.isfile(p)), None)
          if src is None:
              raise RuntimeError('[TETRA codec] cannot find %s.dll. Put it next to the .grc file or set '
                                 'lib_path. Tried: %s' % (base, ', '.join(cands[:8]) + ' ...'))
          now = time.time()
          for old in glob.glob(os.path.join(tempfile.gettempdir(), 'tetra_codec_*')):
              try:                                            # copies left by crashed runs, > 1 h old
                  if now - os.path.getmtime(old) > 3600:
                      shutil.rmtree(old, ignore_errors=True)
              except OSError:
                  pass
          tmp = tempfile.mkdtemp(prefix='tetra_codec_')
          dst = os.path.join(tmp, os.path.basename(src))
          shutil.copyfile(src, dst)
          atexit.register(shutil.rmtree, tmp, True)
          lib = ctypes.CDLL(dst)
          if lib.tetra_wrap_version() != 1:
              raise RuntimeError('[TETRA codec] %s: unexpected wrapper version' % src)
          return lib, src


      def in_grc():
          """True while GRC (editor or grcc) instantiates the block only to read its ports."""
          return 'gnuradio.grc' in sys.modules


      from gnuradio import gr


      class blk(gr.sync_block):
          """ACELP Speech Encoder (ETSI scoder): 240 PCM -> BFI + 137 bits, + local synthesis"""

          def __init__(self, lib_path=''):
              gr.sync_block.__init__(self, name='ACELP Speech Encoder',
                                     in_sig=[(np.int16, 240)], out_sig=[(np.int16, 138), (np.int16, 240)])
              self.lib = None
              if in_grc():
                  return
              # Loaded here, in the main thread while the flowgraph is built: a missing DLL
              # then stops the run with a clear error. (Raised in start(), GNU Radio 3.10
              # would print it and hang.)
              self.lib, src = load_private(lib_path, 'tetra_enc')
              self.lib.tetra_enc_frame.argtypes = [I16, I16, I16]
              self.lib.tetra_enc_init()
              print('[ACELP enc] ETSI speech encoder loaded from %s' % src, flush=True)

          def work(self, input_items, output_items):
              x, ser, syn = input_items[0], output_items[0], output_items[1]
              for k in range(len(x)):
                  self.lib.tetra_enc_frame(x[k], ser[k], syn[k])
              return len(x)
    lib_path: lib_path
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 940
    - 224
    rotation: 0
    state: enabled
