options:
  parameters:
    output_language: python
    generate_options: qt_gui
    gen_linking: dynamic
    gen_cmake: 'On'
    cmake_opt: ''
    category: '[GRC Hier Blocks]'
    run_options: prompt
    placement: (0,0)
    window_size: (1000,1000)
    sizing_mode: fixed
    run: 'True'
    max_nouts: '0'
    catch_exceptions: 'True'
    run_command: '{python} -u {filename}'
    hier_block_src_path: '.:'
    author: ''
    comment: ''
    copyright: ''
    description: 'TETRA ACELP codec loopback: ETSI EN 300 395-2 reference codec, stock blocks + 4 EPBs (ctypes to tetra_enc.dll / tetra_dec.dll)'
    id: tetra_acelp_loopback
    title: TETRA ACELP codec loopback (no radio)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: 'Codec rate, fixed by EN 300 395-2: 8 kHz, 240 samples = 30 ms per frame'
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 200
    - 12
    rotation: 0
    state: enabled
- name: wav_in
  id: variable
  parameters:
    comment: Input speech WAV (mono). Path relative to the .grc folder or absolute
    value: '''speech.wav'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 330
    - 12
    rotation: 0
    state: enabled
- name: wav_rate
  id: variable
  parameters:
    comment: |-
      Sample rate of wav_in. The resampler converts it to 8 kHz.
      Check it in Windows Explorer > Properties > Details, or soxi
    value: '8000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 460
    - 12
    rotation: 0
    state: enabled
- name: wav_out
  id: variable
  parameters:
    comment: Decoded speech is written here (8 kHz, 16-bit)
    value: '''tetra_out.wav'''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 590
    - 12
    rotation: 0
    state: enabled
- name: lib_path
  id: variable
  parameters:
    comment: |-
      Folder (or file) holding tetra_enc.dll and tetra_dec.dll.
      '' = look next to this .grc file, then PATH
    value: ''''''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 720
    - 12
    rotation: 0
    state: enabled
- name: codec_delay
  id: variable
  parameters:
    comment: |-
      Codec delay in samples: 40 = 5 ms (encoder look-ahead).
      Measured by cross-correlation; the input is delayed by this before comparing
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 850
    - 12
    rotation: 0
    state: enabled
- name: snr_win
  id: variable
  parameters:
    comment: 'SNR averaging window: 5 s'
    value: int(5 * samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 980
    - 12
    rotation: 0
    state: enabled
- name: rs_g
  id: variable
  parameters:
    comment: gcd for the resampler ratio
    value: __import__("math").gcd(int(wav_rate), int(samp_rate))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1110
    - 12
    rotation: 0
    state: enabled
- name: sigma
  id: variable
  parameters:
    comment: 'Noise std per +-1 symbol: Es/N0 = 1 / (2 sigma^2)'
    value: (0.7071067811865476 * 10 ** (-esn0_db / 20.0)) if noise_on else 0.0
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1240
    - 12
    rotation: 0
    state: enabled
- name: esn0_db
  id: variable_qtgui_range
  parameters:
    alias: ''
    comment: Channel Es/N0 per coded bit. Only used when noise is on
    rangeType: float
    value: '4'
    start: '-3'
    stop: '15'
    step: '0.5'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '200'
    label: '"Channel Es/N0 [dB]"'
    gui_hint: 0,0,1,2
    outputmsgname: value
    showports: 'False'
    type: float
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 100
    rotation: 0
    state: enabled
- name: noise_on
  id: variable_qtgui_check_box
  parameters:
    alias: ''
    comment: 'Off = clean channel: decoder output must equal the local synthesis'
